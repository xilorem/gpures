#!/bin/sh
set -e

if ! getent group gpures >/dev/null; then
    addgroup --system gpures
fi

install -d -o root -g gpures -m 2775 /var/lib/gpures

if command -v gpures >/dev/null 2>&1; then
    gpures --home /var/lib/gpures init --no-sync >/dev/null || true
fi

if [ -f /var/lib/gpures/reservations.sqlite ]; then
    chown root:gpures /var/lib/gpures/reservations.sqlite
    chmod 0660 /var/lib/gpures/reservations.sqlite
fi

if [ -f /var/lib/gpures/.lock ]; then
    chown root:gpures /var/lib/gpures/.lock
    chmod 0660 /var/lib/gpures/.lock
fi

#DEBHELPER#
